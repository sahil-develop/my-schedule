DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"
# Neon: same connection but without "-pooler" in the host — migrate deploy
# needs a direct (non-PgBouncer) connection to hold its advisory lock.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-value"
JWT_EXPIRES_IN_SECONDS=604800
